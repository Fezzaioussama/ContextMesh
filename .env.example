# Server-only provider settings. Never add a VITE_ prefix to credentials.
# The selected provider's key is used for both the chat model and embeddings.
CONTEXTMESH_MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1

# Select openrouter above to use these settings. Keys never cross providers.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local host development; Compose replaces hostnames with its service names.
CONTEXTMESH_DATABASE_URL=postgresql+psycopg://contextmesh:contextmesh@127.0.0.1:55432/contextmesh
CONTEXTMESH_QDRANT_URL=http://127.0.0.1:6333
# Uploaded originals; the API and worker must share this directory.
CONTEXTMESH_BLOB_DIR=.data/blobs
CONTEXTMESH_DEV_SUBJECT=local-user
CONTEXTMESH_DEV_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
CONTEXTMESH_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Agent and ingestion budgets. The turn lease must exceed the agent deadline.
CONTEXTMESH_PROVIDER_TIMEOUT_SECONDS=45
CONTEXTMESH_AGENT_DEADLINE_SECONDS=60
CONTEXTMESH_TURN_LEASE_SECONDS=90
CONTEXTMESH_JOB_LEASE_SECONDS=90
# Reasoning models spend part of this budget on hidden reasoning tokens.
CONTEXTMESH_MAX_OUTPUT_TOKENS=4096
CONTEXTMESH_MAX_UPLOAD_BYTES=2000000

# Frontend development proxy; this is not a browser provider destination.
CONTEXTMESH_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional integration/smoke test targets. Use a separate disposable database.
CONTEXTMESH_TEST_DATABASE_URL=postgresql+psycopg://contextmesh:contextmesh@127.0.0.1:55432/contextmesh_test
CONTEXTMESH_TEST_QDRANT_URL=http://127.0.0.1:6333
